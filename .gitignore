.DS_Store
.claude/.artifact-effectiveness.jsonl
.claude/.artifact-effectiveness.jsonl.lock

# bv (beads viewer) local config and caches
.bv/

# beads tracker (global ignore excludes .beads; this repo commits it)
!.beads/

# python / uv
.venv/
__pycache__/
*.pyc
.hypothesis/
*.actual

# runtime state
var/
.doctor/
deploy/*
!deploy/README.md

# Beads compliance audit dir (managed by /beads-compliance-and-completion-verification skill)
/beads_compliance_audit/
.coverage
htmlcov/

# scripts/check.sh writes one line per gate here; it is a local trace, not history.
.check.log
.beads_hook.log

# Project invariants live here and are law for every session; the global ignore
# excludes CLAUDE.md as local agent config, which this file is not.
!CLAUDE.md
