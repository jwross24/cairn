#!/usr/bin/env bash
# Two gates, in cost order. Install once per clone:
#
#   git config core.hooksPath .githooks
#
# 1. scripts/check.sh --fast — format, lint and spelling on the whole tree.
# 2. The beads compliance audit, for any bead this commit closes.
#
# Both leave a trace (.check.log, .beads_hook.log). Neither passes quietly when
# its tooling is missing: check.sh denies without uv, and the absence of the
# compliance skill is reported rather than swallowed.
#
# Bypass, named and logged, per gate:
#   CAIRN_CHECK_SKIP='<reason>' git commit …
#   BEADS_HOOK_SKIP=1 git commit …
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

# `git diff --cached` is blind to a close an amend already wrote into HEAD, so the gates
# below sit out an amended close while post-commit still pushes it. Every successful
# path through this hook records the ids it gated; post-commit refuses to push a closed
# bead that record does not name.
#
# The record names the staged tree as well, because a parent and a bead list do not
# identify content: an abandoned run leaves its record behind, and a later
# `--no-verify` commit on the same parent closing the same beads would otherwise be
# vouched for whatever its files hold. `git write-tree` writes objects and moves no
# ref, and the index it hashes is the one the commit is built from.
record_gate() {
  # shellcheck disable=SC2086
  if uv run python scripts/gate_marker.py record \
      --git-dir "$(git rev-parse --git-dir)" \
      --parent "$(git rev-parse --verify -q HEAD || true)" \
      --tree "$(git write-tree 2>/dev/null || true)" \
      ${1:-} >/dev/null 2>&1; then
    printf '%s GATE-RECORD %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${1:-none}" >> .beads_hook.log
  else
    printf '%s GATE-RECORD-FAILED %s; post-commit will refuse to push a close\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${1:-none}" >> .beads_hook.log
    echo "[pre-commit] the gate record could not be written; a close will not push." >&2
  fi
}

if [ -x scripts/check.sh ]; then
  if ! scripts/check.sh --fast; then
    echo "[pre-commit] BLOCKED by scripts/check.sh; see the output above and .check.log" >&2
    exit 1
  fi
else
  echo "[pre-commit] scripts/check.sh is missing or not executable; refusing to commit blind." >&2
  echo "             chmod +x scripts/check.sh, or bypass with CAIRN_CHECK_SKIP='<reason>'" >&2
  exit 1
fi

# Beads this commit closes. Their declared test plan is checked deterministically
# before the scored audit runs: the audit judges whether the tests are good, this
# only answers whether the files the bead named are there at all.
#
# An empty list here is indistinguishable from a git that could not answer, and it
# switches off the test-plan gate, the artifact-block gate and the corrector at once,
# so the resolver's own git-failure code denies instead.
NEWLY_CLOSED="$(uv run python scripts/closing_commit.py --staged 2>/tmp/cairn-closing-commit.err)"
CLOSING_RC=$?
if [ "$CLOSING_RC" -ne 0 ]; then
  printf '%s DENY closing-commit resolver rc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$CLOSING_RC" >> .beads_hook.log
  echo "[pre-commit] BLOCKED: scripts/closing_commit.py --staged exited $CLOSING_RC." >&2
  cat /tmp/cairn-closing-commit.err >&2
  echo "             Which beads this commit closes is unknown, so no gate keyed to a close ran." >&2
  exit 1
fi

if [ -n "$NEWLY_CLOSED" ]; then
  # shellcheck disable=SC2086
  if ! scripts/bead-test-plan.sh $NEWLY_CLOSED; then
    echo "[pre-commit] BLOCKED: a bead being closed names a test file that is absent or empty." >&2
    exit 1
  fi
  # The compliance audit below reads the bead body with regular expressions, and a
  # body written as prose yields nothing for it to check — a prose bead and an empty
  # one score identically. The ARTIFACTS block is the extractable form of what a
  # close already writes, and audit-policy.yaml's unmeasured_dimensions switch is
  # only meaningful while every closing bead carries one.
  # shellcheck disable=SC2086
  if ! scripts/bead-artifact-block.sh $NEWLY_CLOSED; then
    echo "[pre-commit] BLOCKED: a bead being closed carries no valid ARTIFACTS block." >&2
    exit 1
  fi
fi

SKILL=""
for cand in \
  ".claude/skills/beads-compliance-and-completion-verification" \
  "$HOME/.claude/skills/beads-compliance-and-completion-verification" \
  "$HOME/.codex/skills/beads-compliance-and-completion-verification"; do
  if [ -d "$cand" ]; then SKILL="$cand"; break; fi
done

if [ -z "$SKILL" ]; then
  printf '%s NO-SKILL beads compliance gate did not run\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> .beads_hook.log
  echo "[pre-commit] the beads compliance skill is not installed; its gate did not run (logged)." >&2
  record_gate "$NEWLY_CLOSED"
  exit 0
fi

# The audit runs on a forked copy of the skill (CLAUDE.md lists the call sites).
# An upstream update restores the originals, and the visible symptom is nothing at
# all: audit-policy.yaml still resolves, the audit still exits 0, and the weights
# silently stop reaching the scorer. These two markers are the load-bearing halves
# of that fork, so their absence denies rather than scoring on defaults.
FORK_MISSING=""
[ -f "$SKILL/scripts/sync-rubric-from-policy.py" ] || FORK_MISSING="scripts/sync-rubric-from-policy.py"
if [ -z "$FORK_MISSING" ] && ! grep -q "sync-rubric-from-policy.py" "$SKILL/scripts/bootstrap-audit.sh"; then
  FORK_MISSING="the sync call in scripts/bootstrap-audit.sh"
fi
# br 0.2.22 exits 1 for any check that is not "ok", and reports a malformed page
# as status "error" with an anomaly of severity "recoverable". The upstream health
# gate keys on "fail" and "error", so it reads a corrupt store as clean; the fork
# keys on the benign values instead. Reverting it restores a gate that refuses
# every workspace carrying an advisory WARN and passes one whose pages are gone,
# and neither symptom names itself.
if [ -z "$FORK_MISSING" ] && ! grep -q "def corrupting:" "$SKILL/scripts/bootstrap-audit.sh"; then
  FORK_MISSING="the corruption predicate in scripts/bootstrap-audit.sh"
fi
if [ -z "$FORK_MISSING" ] && ! grep -q "no readable check list" "$SKILL/scripts/inventory-beads.sh"; then
  FORK_MISSING="the guarded doctor capture in scripts/inventory-beads.sh"
fi
# An "n/a" note means the extractor looked and found nothing, and a "WAIVED" note means
# the phase never ran. Upstream matches both with one regex, so a bead carrying no
# documentation deliverable falls under the coverage floor and is convicted of theater
# on a score the scorer declined to issue. The fork counts n/a as a measurement for
# docs_etc alone; widening it to implementation awards 250 points to a body the
# extractor could not read. scripts/audit_attribution.py blocks on the `unverifiable`
# flag this fork emits, so a revert leaves that gate keyed on a field nobody sets.
if [ -z "$FORK_MISSING" ] && ! grep -q "NA_MEASURED_DIMENSIONS" "$SKILL/scripts/score-bead.py"; then
  FORK_MISSING="the n/a-is-a-measurement split in scripts/score-bead.py"
fi
if [ -n "$FORK_MISSING" ]; then
  printf '%s FORK-REVERTED %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$FORK_MISSING" >> .beads_hook.log
  echo "[pre-commit] the compliance skill no longer carries $FORK_MISSING." >&2
  echo "             Without it the audit still exits 0 and still prints a score, while either" >&2
  echo "             binding no weights or reading a corrupt store as clean. It would not say so." >&2
  echo "             Re-apply the fork (CLAUDE.md lists the sites), or bypass:" >&2
  echo "             CAIRN_AUDIT_FORK_OK='<reason>' git commit ..." >&2
  if [ -z "${CAIRN_AUDIT_FORK_OK:-}" ]; then
    exit 1
  fi
  printf '%s BYPASS fork check: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$CAIRN_AUDIT_FORK_OK" >> .beads_hook.log
fi
printf '%s FORK-PRESENT compliance skill carries the rubric sync\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> .beads_hook.log

# The audit's precondition is a readable bead store, and the skill's hook reports
# every nonzero result from single-bead-audit.sh as "score < threshold" — a
# precondition that failed is indistinguishable there from a bead that was
# measured and found wanting. This classifies the store first, so a refusal names
# what happened. Its three outcomes reach .check.log.
uv run python scripts/beads_doctor_gate.py > /tmp/cairn-doctor-gate.out 2>&1
DOCTOR_GATE_RC=$?
cat /tmp/cairn-doctor-gate.out >&2
if [ "$DOCTOR_GATE_RC" -ne 0 ]; then
  echo "[pre-commit] BLOCKED: the bead store's soundness is unestablished, so the compliance" >&2
  echo "             audit did not run and no bead was scored. This is not a low score." >&2
  exit 1
fi

# The skill's hook defaults to 700 and passes it as an explicit --threshold, which
# single-bead-audit.sh takes over the policy file's value. audit-policy.yaml is the
# single source for this project, so its threshold is handed to the hook the one
# way the hook accepts. A policy that cannot be read leaves the skill's default in
# place and says so, rather than silently gating at a number nobody chose.
POLICY_THRESHOLD="$(uv run --quiet --with pyyaml python -c '
import pathlib, sys, yaml
for name in ("audit-policy.yaml", ".beads/audit-policy.yaml"):
    path = pathlib.Path(name)
    if path.is_file():
        value = (yaml.safe_load(path.read_text()) or {}).get("threshold")
        if isinstance(value, int) and not isinstance(value, bool):
            print(value)
        sys.exit(0)
' 2>/dev/null || true)"
if [ -n "$POLICY_THRESHOLD" ]; then
  export BEADS_HOOK_THRESHOLD="$POLICY_THRESHOLD"
  printf '%s THRESHOLD %s from audit-policy.yaml\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$POLICY_THRESHOLD" >> .beads_hook.log
else
  printf '%s THRESHOLD-UNREAD audit-policy.yaml gave no threshold; the skill default stands\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> .beads_hook.log
  echo "[pre-commit] audit-policy.yaml gave no threshold; the compliance gate runs at the skill's default." >&2
fi

# Invoked through bash: the skill ships this asset without the executable bit,
# and a hook that dies on EACCES is a gate that silently stopped running.
PASS_BEFORE="$(ls -1d beads_compliance_audit/passes/*/ 2>/dev/null | sed 's|.*/passes/||; s|/$||' | sort | tail -1)"
bash "$SKILL/assets/pre-commit-hook.sh"
AUDIT_RC=$?

# The skill's anomaly scan picks a bead's "closing commit" by grepping commit
# messages for the bead id, and this project asks every session to cite its beads
# there, so the pick belongs to whichever bead committed last. A verdict that moves
# with other beads' commit messages measures the message stream. The corrector
# resolves each audited bead's closing commit from the bead store's own status flip
# and re-scores, so the verdict this hook acts on is the corrected one.
if [ -n "$NEWLY_CLOSED" ]; then
  ATTR_ARGS=( --audit-dir beads_compliance_audit --skill "$SKILL" )
  [ -n "$PASS_BEFORE" ] && ATTR_ARGS+=( --after "$PASS_BEFORE" )
  [ -n "${POLICY_THRESHOLD:-}" ] && ATTR_ARGS+=( --threshold "$POLICY_THRESHOLD" )
  uv run python scripts/audit_attribution.py "${ATTR_ARGS[@]}" > /tmp/cairn-audit-attribution.out 2>&1
  ATTR_RC=$?
  cat /tmp/cairn-audit-attribution.out >&2
  case "$ATTR_RC" in
    0|1)
      printf '%s ATTRIBUTION rc=%s (skill audit rc=%s)\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$ATTR_RC" "$AUDIT_RC" >> .beads_hook.log
      AUDIT_RC=$ATTR_RC
      ;;
    3)
      printf '%s ATTRIBUTION-DENY git could not answer; rc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$ATTR_RC" >> .beads_hook.log
      echo "[pre-commit] BLOCKED: the attribution corrector could not read git, so every" >&2
      echo "             bead's closing commit is unknown and no score here is evidence." >&2
      AUDIT_RC=1
      ;;
    *)
      printf '%s ATTRIBUTION-NOTHING rc=%s; the skill audit verdict stands uncorrected\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$ATTR_RC" >> .beads_hook.log
      echo "[pre-commit] the attribution corrector found no scored bead; the closing-commit" >&2
      echo "             anomalies keep the skill's own attribution for this commit." >&2
      ;;
  esac
fi

# A scorecard whose dimension table, banner and denominator disagree misreports
# the arithmetic behind the verdict: under unmeasured_dimensions=excluded a
# dimension whose phase was stubbed carries no credit, and a table that prints it
# at full weight tells the reader 500 free points were granted. The presentation
# lives in the forked score-bead.py, so an upstream update restores the
# disagreement; this reads the scorecard back and refuses it.
NEWEST_PASS="$(ls -1d beads_compliance_audit/passes/*/ 2>/dev/null | sort | tail -1)"
if [ -n "$NEWEST_PASS" ] && [ -d "${NEWEST_PASS}beads" ]; then
  if uv run python scripts/scorecard_coherence.py "${NEWEST_PASS}beads" > /tmp/cairn-scorecard-coherence.out 2>&1; then
    printf '%s SCORECARD-COHERENT %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$NEWEST_PASS" >> .beads_hook.log
  else
    printf '%s SCORECARD-INCOHERENT %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$NEWEST_PASS" >> .beads_hook.log
    echo "[pre-commit] BLOCKED: a scorecard disagrees with its own arithmetic." >&2
    cat /tmp/cairn-scorecard-coherence.out >&2
    echo "             Re-apply the score-bead.py presentation fork (CLAUDE.md lists the sites), or bypass:" >&2
    echo "             CAIRN_AUDIT_FORK_OK='<reason>' git commit ..." >&2
    [ -n "${CAIRN_AUDIT_FORK_OK:-}" ] || exit 1
    printf '%s BYPASS scorecard coherence: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$CAIRN_AUDIT_FORK_OK" >> .beads_hook.log
  fi
else
  printf '%s SCORECARD-NO-PASS no audit pass directory to check\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> .beads_hook.log
fi

# gather-evidence.sh performs no search at all for a test item whose id ends in
# `primary`, for an item in migrations, feature_flags or telemetry, and for a code
# artifact carrying no expected_path_hints; score-bead.py lists every one of them under
# `## Missing items (verbatim)`, and remediate.sh reads that section verbatim into a
# minted completion-debt bead's acceptance criteria. A silence travels as a finding.
# The corrector separates the two and refuses a false-closed verdict every one of
# whose items is unmeasured. Each of its outcomes reaches .check.log under its own name,
# including the ones where an input could not be read at all.
if [ -n "$NEWEST_PASS" ] && [ -d "${NEWEST_PASS}beads" ]; then
  uv run python scripts/audit_missing_items.py "${NEWEST_PASS}beads" > /tmp/cairn-missing-items.out 2>&1
  MISSING_RC=$?
  cat /tmp/cairn-missing-items.out >&2
  case "$MISSING_RC" in
    0)
      printf '%s MISSING-ITEMS-SEPARATED %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$NEWEST_PASS" >> .beads_hook.log
      ;;
    1)
      printf '%s MISSING-ITEMS-DEBT-FROM-NOTHING %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$NEWEST_PASS" >> .beads_hook.log
      echo "[pre-commit] BLOCKED: a bead is FALSE-CLOSED on items no search ever looked for." >&2
      echo "             The verdict rests on the audit's silence, so no debt may be minted from it." >&2
      echo "             Run the phase that measures them, or bypass:" >&2
      echo "             CAIRN_MISSING_ITEMS_SKIP='<reason>' git commit ..." >&2
      AUDIT_RC=1
      ;;
    3)
      printf '%s MISSING-ITEMS-NO-SECTION %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$NEWEST_PASS" >> .beads_hook.log
      echo "[pre-commit] BLOCKED: a scorecard carries no '## Missing items (verbatim)' heading." >&2
      echo "             The corrector read no item from it, so its silence is not a pass." >&2
      echo "             Re-apply the score-bead.py fork (CLAUDE.md lists the sites), or bypass:" >&2
      echo "             CAIRN_MISSING_ITEMS_SKIP='<reason>' git commit ..." >&2
      AUDIT_RC=1
      ;;
    4)
      printf '%s MISSING-ITEMS-UNREADABLE-SPEC %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$NEWEST_PASS" >> .beads_hook.log
      echo "[pre-commit] BLOCKED: a bead's spec.json does not parse, so its checklist is unknown." >&2
      echo "             CAIRN_MISSING_ITEMS_SKIP='<reason>' git commit ..." >&2
      AUDIT_RC=1
      ;;
    5)
      printf '%s MISSING-ITEMS-UNREADABLE-SCORECARD %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$NEWEST_PASS" >> .beads_hook.log
      echo "[pre-commit] BLOCKED: a bead's scorecard.md cannot be read, so no item was separated." >&2
      echo "             CAIRN_MISSING_ITEMS_SKIP='<reason>' git commit ..." >&2
      AUDIT_RC=1
      ;;
    6)
      printf '%s MISSING-ITEMS-UNREADABLE-SPEC-FILE %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$NEWEST_PASS" >> .beads_hook.log
      echo "[pre-commit] BLOCKED: a bead's spec.json cannot be read, so its checklist is unknown." >&2
      echo "             CAIRN_MISSING_ITEMS_SKIP='<reason>' git commit ..." >&2
      AUDIT_RC=1
      ;;
    7)
      printf '%s MISSING-ITEMS-SPEC-NOT-AN-OBJECT %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$NEWEST_PASS" >> .beads_hook.log
      echo "[pre-commit] BLOCKED: a bead's spec.json parses to something other than an object," >&2
      echo "             so it names no checklist and its silence is not a pass." >&2
      echo "             CAIRN_MISSING_ITEMS_SKIP='<reason>' git commit ..." >&2
      AUDIT_RC=1
      ;;
    *)
      printf '%s MISSING-ITEMS-DENY rc=%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$MISSING_RC" "$NEWEST_PASS" >> .beads_hook.log
      echo "[pre-commit] BLOCKED: the missing-items corrector found no scorecard to read in" >&2
      echo "             ${NEWEST_PASS}beads, so nothing separated a gap from a stub." >&2
      echo "             CAIRN_MISSING_ITEMS_SKIP='<reason>' git commit ..." >&2
      AUDIT_RC=1
      ;;
  esac
else
  printf '%s MISSING-ITEMS-NO-PASS no audit pass directory to separate\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> .beads_hook.log
fi

if [ "$AUDIT_RC" -eq 0 ]; then
  record_gate "$NEWLY_CLOSED"
fi

exit "$AUDIT_RC"
