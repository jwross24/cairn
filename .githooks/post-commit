#!/usr/bin/env bash
# Push a commit that closes a bead, so CI verifies every close on a machine that
# is not this one. Install once per clone:
#
#   git config core.hooksPath .githooks
#
# A slice commit is not pushed: a bead close is the ship, and CI on a private
# macOS runner bills at ten times wall clock, so a run per slice buys little and
# costs a lot.
#
# Three outcomes, three lines in .check.log: PUSHED, SKIP, DENY. A push that
# fails is loud and leaves the commit local; nothing here rewrites history or
# forces.
#
# Bypass, named and logged:
#   CAIRN_PUSH_SKIP='<reason>' git commit …
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 0

LOG="$ROOT/.check.log"
say() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >>"$LOG"; }

if [ -n "${CAIRN_PUSH_SKIP:-}" ]; then
  say "BYPASS post-commit push: ${CAIRN_PUSH_SKIP}"
  echo "[post-commit] push skipped: ${CAIRN_PUSH_SKIP}" >&2
  exit 0
fi

CLOSED="$(uv run python scripts/closing_commit.py --commit HEAD 2>/tmp/cairn-closing-commit-head.err)"
CLOSING_RC=$?

# A resolver that could not read git prints nothing, which is the same output as a
# commit that closes no bead. Pushing is what CI sees, so the two are separated here.
if [ "$CLOSING_RC" -ne 0 ]; then
  say "DENY post-commit push: closing-commit resolver rc=$CLOSING_RC on $(git rev-parse --short HEAD)"
  echo "[post-commit] scripts/closing_commit.py --commit HEAD exited $CLOSING_RC." >&2
  cat /tmp/cairn-closing-commit-head.err >&2
  echo "              Whether this commit closes a bead is unknown; nothing was pushed." >&2
  echo "              Resolve and run: git push origin $(git rev-parse --abbrev-ref HEAD)" >&2
  exit 0
fi

# pre-commit records the ids its gates ran for. The record is read once and deleted,
# so an amended close -- invisible to `git diff --cached` and therefore ungated -- finds
# nothing vouching for it here.
# shellcheck disable=SC2086
GATE_OUT="$(uv run python scripts/gate_marker.py check \
  --git-dir "$(git rev-parse --git-dir)" \
  --parent "$(git rev-parse --verify -q HEAD^ || true)" \
  $CLOSED 2>&1)"
GATE_RC=$?
if [ "$GATE_RC" -ne 0 ]; then
  say "DENY post-commit push: $GATE_OUT"
  echo "[post-commit] $GATE_OUT" >&2
  echo "              Nothing was pushed, so the close is local and CI has not seen it." >&2
  echo "              Run the gates over the close, then push by hand:" >&2
  echo "                scripts/bead-test-plan.sh $(echo "$CLOSED" | tr '\n' ' ')" >&2
  echo "                scripts/bead-artifact-block.sh $(echo "$CLOSED" | tr '\n' ' ')" >&2
  echo "                git push origin $(git rev-parse --abbrev-ref HEAD)" >&2
  exit 0
fi

if [ -z "$CLOSED" ]; then
  say "SKIP post-commit push: $(git rev-parse --short HEAD) closes no bead"
  exit 0
fi

IDS="$(echo "$CLOSED" | tr '\n' ' ' | sed 's/ $//')"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"

if ! git remote get-url origin >/dev/null 2>&1; then
  say "DENY post-commit push: no origin remote; $IDS closed and unpushed"
  echo "[post-commit] $IDS closed, and there is no origin remote to push to." >&2
  echo "              The close is local only; CI has not seen it." >&2
  exit 0
fi

echo "[post-commit] $IDS closed; pushing $BRANCH so CI verifies the close." >&2
if git push origin "$BRANCH"; then
  say "PUSHED post-commit $(git rev-parse --short HEAD) ($IDS) -> origin/$BRANCH"
else
  say "DENY post-commit push: git push failed; $IDS closed and unpushed"
  echo "[post-commit] PUSH FAILED. $IDS is closed locally and CI has not seen it." >&2
  echo "              Resolve and run: git push origin $BRANCH" >&2
fi
exit 0
