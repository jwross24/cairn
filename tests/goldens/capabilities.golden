cs", "read_only": true, "summary": "print the paste-ready agent handbook"}, {"aliases": ["self-test"], "dangerous": false, "dry_run_default": false, "gating": null, "json": true, "name": "selftest", "read_only": false, "summary": "run a skill's vendored known-answer corpus and record its certificate; exit 2 on any failure"}, {"aliases": [], "dangerous": false, "dry_run_default": false, "gating": null, "json": true, "name": "startup-scan", "read_only": false, "summary": "move every attempt left RUNNING by a dead harness to INTERRUPTED before any new launch"}], "contract_version": "1", "default_paths": {"attest": "deploy/attestations.log", "bundle": "deploy/gate-bundle.sqlite", "db": "var/substrate.sqlite", "gp_bin": "/opt/homebrew/bin/gp", "pin": "deploy/gate-bundle.pin"}, "emits_ansi": false, "env_vars": {"CAIRN_LOG": "log level when --log is absent (default INFO); records are JSON lines on stderr", "HYPOTHESIS_PROFILE": "test-only: ci (500 examples) or dev (50)", "NO_COLOR": "honored trivially: cairn never emits ANSI sequences", "SOURCE_DATE_EPOCH": "any emitted timestamp uses this epoch instead of the wall clock", "UPDATE_GOLDENS": "test-only: 1 rewrites golden files instead of diffing them"}, "exit_codes": {"cli": {"0": "OK", "1": "USER_INPUT: bad arguments, malformed input, unknown id; the error names the exact command to run", "2": "GATE_REFUSED: a gate or safety gate refused, or a self-test failed (fail closed): KAT mismatch, bundle hash differs from the pin, TierRefused, a verifier FAIL inside a gate run, a dangerous operation invoked without its --yes/--force; state untouched", "3": "ENVIRONMENT: a required binary, stack, file or database is missing or wrongly shaped (gp absent, PARI stack, bundle/pin/attestation file, substrate, EPERM on a flagged file)", "4": "BACKEND: a subprocess the command needed died, timed out or returned malformed output outside any gate's classification, or an unexpected exception", "5": "CONFLICT: a second writer holds the substrate (database is locked after the busy timeout)"}, "doctor": {"0": "healthy", "1": "findings present, no --fix requested", "2": "fix attempted, partial", "3": "fix failed and rolled back", "4": "refused unsafe", "5": "concurrency lost (lock held)", "64": "usage error"}}, "global_options": {"--attest": "deploy/attestations.log", "--bundle": "deploy/gate-bundle.sqlite", "--db": "var/substrate.sqlite", "--log": "INFO", "--pin": "deploy/gate-bundle.pin"}, "interactive": false, "python": "[PYTHON]", "schema_version": 1, "stderr_is_diagnostics": true, "stdout_is_data": true, "tool": "cairn", "version": "[VERSION]"}
