+static int mitm480_words(const UnitSet *S, const unsigned char *fufix, int nmin, GList *G, u64 target) {
+    int nun = S->nun;
+    G->nun = nun; G->n = 0;
+    g_wm_calls = 0; g_wm_space = 0;
+    for (int wq = 0; wq < nmin; wq++) {
+        const unsigned char *fu = fufix + (size_t)wq * nun;
+        UnitSet S2 = *S;
+        int *nc2 = calloc((size_t)nun, sizeof(int));
+        int **map = calloc((size_t)nun, sizeof(int *));
+        for (int u = 0; u < nun; u++) {
+            const Unit *U = &S->u[u];
+            if (U->isnu || fu[u] == 0) {
+                map[u] = malloc((size_t)U->nc * sizeof(int));
+                S2.u[u].val = malloc((size_t)U->nc * sizeof(u64));
+                for (int c = 0; c < U->nc; c++) { map[u][c] = c; S2.u[u].val[c] = U->val[c]; }
+                nc2[u] = U->nc;
+            } else {
+                int cnt = 0;
+                for (int c = 0; c < U->nc; c++) if (U->n[c][0] >= fu[u]) cnt++;
+                map[u] = malloc((size_t)cnt * sizeof(int));
+                S2.u[u].val = malloc((size_t)cnt * sizeof(u64));
+                int q = 0;
+                for (int c = 0; c < U->nc; c++) if (U->n[c][0] >= fu[u]) { map[u][q] = c; S2.u[u].val[q] = U->val[c]; q++; }
+                nc2[u] = cnt;
+            }
+            S2.u[u].nc = nc2[u];
+        }
+        GList G2 = {0, 0, 0, NULL};
+        int bud = mitm480(&S2, &G2, target);
+        g_wm_calls += 1; g_wm_space += g_mitm_space;
+        if (!bud) {
+            for (long r = 0; r < G2.n; r++) {
+                uint32_t *row = G2.ci + (size_t)r * nun;
+                for (int u = 0; u < nun; u++) row[u] = (uint32_t)map[u][row[u]];
+                gl_push(G, row);
+            }
+        }
+        for (int u = 0; u < nun; u++) { free(S2.u[u].val); free(map[u]); }
+        free(map); free(nc2); free(G2.ci);
+        if (bud) return 1;
+    }
+    if (G->n > 1) {
+        g_cmpw = nun;
+        qsort(G->ci, (size_t)G->n, (size_t)nun * 4, cmp_row);
+        long w = 1;
+        for (long r = 1; r < G->n; r++) {
+            if (memcmp(G->ci + (size_t)r * nun, G->ci + (size_t)(w - 1) * nun, (size_t)nun * 4) != 0) {
+                if (w != r) memcpy(G->ci + (size_t)w * nun, G->ci + (size_t)r * nun, (size_t)nun * 4);
+                w++;
+            }
+        }
+        G->n = w;
+    }
+    g_mitm_space = g_wm_space;
+    return 0;
+}
