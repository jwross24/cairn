+def norm_row(r):
+    r = dict(r)
+    if 'c_stats' in r:
+        r['c_stats'] = {k: v for k, v in r['c_stats'].items() if k != 'open'}
+    r.pop('levels', None)
+    return r
+
+
+def rows_shrink(ra, rb):
+    for x, y in zip(ra, rb):
+        if 'levels' not in x:
+            continue
+        if y['c_stats']['open'] > x['c_stats']['open']:
+            return False
+        lb = {l[0]: l for l in y['levels']}
+        for l in x['levels']:
+            m = lb.get(l[0])
+            if m is None:
+                continue
+            if m[2] > l[2] or (l[0] > 12 and m[1] > l[1]):
+                return False
+    return True
 
 
